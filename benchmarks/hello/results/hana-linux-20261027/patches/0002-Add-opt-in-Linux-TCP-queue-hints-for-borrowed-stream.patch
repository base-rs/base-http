+#[cfg(target_os = "linux")]
+#[test]
+fn tcp_queue_hints_skip_empty_receives_and_preserve_queued_data_and_fin() {
+    let (selector, mut worker, socket, mut peer) = setup();
+    let selector = selector.with_tcp_read_hints();
+    let never = Cancellation::never();
+    let mut reader = ReadinessSocketStreamReader::new(&selector, &socket).unwrap();
+    assert!(reader.tcp_read_hint);
+    prime(&mut reader, &mut peer, &mut worker);
+    let registration = reader.registration.as_ref().unwrap().clone();
+    let direction = registration.direction(Interest::Readable);
+    assert_eq!(direction.snapshot() & 1, 0);
+    let calls = std::sync::atomic::AtomicUsize::new(0);
+    let mut bytes = [0; 4];
+    {
+        let mut reading = Box::pin(reader.read_with(bytes.len(), &never, |socket| {
+            calls.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            crate::linux_tcp::recv(socket, &mut bytes)
+        }));
+        assert!(block_on(poll_once(&mut reading)).is_none());
+        assert_eq!(calls.load(std::sync::atomic::Ordering::Relaxed), 0);
+        peer.write_all(b"abcdefgh").unwrap();
+        assert_eq!(drive(reading, &mut worker).unwrap(), 4);
+    }
+    assert_eq!(&bytes, b"abcd");
+    assert_ne!(direction.snapshot() & 1, 0);
+    assert_eq!(block_on(reader.read_into(&mut bytes, &never)).unwrap(), 4);
+    assert_eq!(&bytes, b"efgh");
+    // Even a full read can prove exhaustion when the same receive reports it.
+    assert_eq!(direction.snapshot() & 1, 0);
+    peer.write_all(b"bye").unwrap();
+    peer.shutdown(std::net::Shutdown::Write).unwrap();
+    std::thread::sleep(Duration::from_millis(10));
+    assert_eq!(
+        drive(reader.read_into(&mut bytes, &never), &mut worker).unwrap(),
+        3
+    );
+    assert_eq!(&bytes[..3], b"bye");
+    assert_ne!(direction.snapshot() & 1, 0);
+    assert_eq!(block_on(reader.read_into(&mut bytes, &never)).unwrap(), 0);
+}
