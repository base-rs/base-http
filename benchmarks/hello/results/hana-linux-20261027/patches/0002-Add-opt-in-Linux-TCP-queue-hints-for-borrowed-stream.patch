+#[test]
+fn tcp_queue_hinted_stream_preserves_urgent_suffix_and_fin() {
+    use base_scheduler::SocketStreamReader;
+    for consume_urgent in [false, true] {
+        let (selector, driver) = IoUringSelector::new(options()).unwrap();
+        let selector = selector.with_tcp_read_hints();
+        let mut worker = driver.enter();
+        let wake = worker.waker();
+        let mut context = Context::from_waker(&wake);
+        let (socket, mut peer) = sockets(&selector);
+        peer.set_nodelay(true).unwrap();
+        let never = Cancellation::never();
+        let mut reader = crate::io_uring_socket_stream_reader::IoUringSocketStreamReader::new(
+            &selector, &socket,
+        )
+        .unwrap();
+        let mut bytes = [0; 64];
+        {
+            let mut read = pin!(reader.read_into(&mut bytes, &never));
+            assert!(read.as_mut().poll(&mut context).is_pending());
+            worker.turn(Some(Duration::ZERO)).unwrap();
+            peer.write_all(b"x").unwrap();
+            assert_eq!(drive(&mut worker, &mut context, read.as_mut()).unwrap(), 1);
+        }
+        peer.write_all(b"before").unwrap();
+        socket2::SockRef::from(&peer)
+            .send_with_flags(b"!", libc::MSG_OOB)
+            .unwrap();
+        peer.write_all(b"after").unwrap();
+        std::thread::sleep(Duration::from_millis(10));
+        if consume_urgent {
+            // The independent native owner models a pre-existing socket alias.
+            let owner = unsafe { socket.retain_native() };
+            let mut byte = [std::mem::MaybeUninit::<u8>::uninit(); 1];
+            assert_eq!(
+                owner
+                    .get_ref()
+                    .recv_with_flags(&mut byte, libc::MSG_OOB | libc::MSG_DONTWAIT)
+                    .unwrap(),
+                1
+            );
+        }
+        {
+            let mut read = pin!(reader.read_into(&mut bytes, &never));
+            assert_eq!(drive(&mut worker, &mut context, read.as_mut()).unwrap(), 6);
+        }
+        assert_eq!(&bytes[..6], b"before");
+        assert_eq!(block_on(reader.read_into(&mut bytes, &never)).unwrap(), 5);
+        assert_eq!(&bytes[..5], b"after");
+        // A cancelled wait must not consume readiness for a subsequent caller.
+        let cancelled = Cancellation::new();
+        {
+            let mut read = pin!(reader.read_into(&mut bytes, &cancelled));
+            assert!(read.as_mut().poll(&mut context).is_pending());
+            cancelled.cancel();
+            assert!(matches!(
+                read.as_mut().poll(&mut context),
+                Poll::Ready(Err(OperationError::Cancelled(_)))
+            ));
+        }
+        peer.write_all(b"bye").unwrap();
+        peer.shutdown(std::net::Shutdown::Write).unwrap();
+        std::thread::sleep(Duration::from_millis(10));
+        {
+            let mut read = pin!(reader.read_into(&mut bytes, &never));
+            assert_eq!(drive(&mut worker, &mut context, read.as_mut()).unwrap(), 3);
+        }
+        assert_eq!(&bytes[..3], b"bye");
+        assert_eq!(block_on(reader.read_into(&mut bytes, &never)).unwrap(), 0);
+        {
+            let mut close = pin!(reader.close());
+            drive(&mut worker, &mut context, close.as_mut()).unwrap();
+        }
+        drop(reader);
+        block_on(selector.socket_close(socket)).unwrap();
+        selector.close();
+        while !worker.turn(Some(Duration::ZERO)).unwrap() {}
+        block_on(selector.shutdown());
+    }
+}
