+// Released under the MIT License.
+// Copyright, 2026, by Samuel Williams.
+
+//! Shared Linux TCP queue hints for borrowed stream readers.
+
+use socket2::Socket;
+use std::{io, mem, os::fd::AsRawFd};
+
+/// Enable receive queue hints. Unsupported socket kinds/kernels keep the ordinary read path.
+pub fn enable(socket: &Socket) -> bool {
+    let enabled: libc::c_int = 1;
+    // SAFETY: setsockopt synchronously borrows one initialized integer.
+    unsafe {
+        libc::setsockopt(
+            socket.as_raw_fd(),
+            libc::IPPROTO_TCP,
+            libc::TCP_INQ,
+            (&enabled as *const libc::c_int).cast(),
+            mem::size_of_val(&enabled) as _,
+        ) == 0
+    }
+}
+
+/// Receive bytes and report whether the kernel's queue hint proves exhaustion.
+/// Missing/truncated hints retain readiness. A positive hint includes queued FIN.
+pub fn recv(socket: &Socket, buffer: &mut [u8]) -> io::Result<(usize, bool)> {
+    let mut vector = libc::iovec {
+        iov_base: buffer.as_mut_ptr().cast(),
+        iov_len: buffer.len(),
+    };
+    // usize alignment is sufficient for cmsghdr on all supported Linux targets.
+    let mut control = [0usize; 8];
+    // SAFETY: zero is a valid empty msghdr before installing the borrowed buffers.
+    let mut header: libc::msghdr = unsafe { mem::zeroed() };
+    header.msg_iov = &mut vector;
+    header.msg_iovlen = 1;
+    header.msg_control = control.as_mut_ptr().cast();
+    header.msg_controllen = mem::size_of_val(&control);
+    // SAFETY: all output ranges are exclusive and live until this synchronous nonblocking call returns.
+    let count = unsafe { libc::recvmsg(socket.as_raw_fd(), &mut header, libc::MSG_DONTWAIT) };
+    if count < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut drained = false;
+    if header.msg_flags & libc::MSG_CTRUNC == 0 {
+        // SAFETY: recvmsg initialized the indicated control prefix; the libc iterators stay inside it.
+        let mut message = unsafe { libc::CMSG_FIRSTHDR(&header) };
+        while !message.is_null() {
+            // SAFETY: the iterator points to a complete aligned cmsghdr in the live control range.
+            let cmsg = unsafe { &*message };
+            if cmsg.cmsg_level == libc::IPPROTO_TCP
+                && cmsg.cmsg_type == libc::TCP_INQ
+                && cmsg.cmsg_len
+                    >= unsafe { libc::CMSG_LEN(mem::size_of::<libc::c_int>() as _) } as usize
+            {
+                // SAFETY: checked payload length; unaligned reads also cover 32-bit ancillary ABIs.
+                let remaining = unsafe {
+                    libc::CMSG_DATA(message)
+                        .cast::<libc::c_int>()
+                        .read_unaligned()
+                };
+                drained = remaining == 0;
+                break;
+            }
+            // SAFETY: header and current message belong to this initialized ancillary range.
+            message = unsafe { libc::CMSG_NXTHDR(&header, message) };
+        }
+    }
+    Ok((count as usize, drained))
+}
