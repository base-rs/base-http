+// Released under the MIT License.
+// Copyright, 2026, by Samuel Williams.
+
+//! Experimental worker-owned Linux epoll. Each poller has exactly one waiting worker.
+
+use polling::{Event, PollMode};
+use std::{
+    io,
+    os::fd::{AsRawFd, FromRawFd, OwnedFd},
+    ptr,
+    time::Duration,
+};
+
+pub(super) const INTERRUPT: usize = usize::MAX;
+const BATCH: usize = 1024;
+
+#[repr(C)]
+struct KernelTimespec {
+    tv_sec: i64,
+    tv_nsec: i64,
+}
+const READ: u32 = (libc::EPOLLIN | libc::EPOLLPRI | libc::EPOLLERR | libc::EPOLLHUP) as u32;
+const WRITE: u32 = (libc::EPOLLOUT | libc::EPOLLERR | libc::EPOLLHUP) as u32;
+
+pub(super) struct Poller {
+    queue: OwnedFd,
+    interrupt: OwnedFd,
+    precise_timeout: bool,
+}
+impl Poller {
+    pub(super) fn new() -> io::Result<Self> {
+        // SAFETY: Both calls return new, exclusively owned descriptors.
+        let queue = owned(unsafe { libc::epoll_create1(libc::EPOLL_CLOEXEC) })?;
+        let interrupt = owned(unsafe { libc::eventfd(0, libc::EFD_CLOEXEC | libc::EFD_NONBLOCK) })?;
+        // Probe before registering any source, so the probe cannot consume an event.
+        let mut event = libc::epoll_event { events: 0, u64: 0 };
+        let zero = KernelTimespec {
+            tv_sec: 0,
+            tv_nsec: 0,
+        };
+        let precise_timeout = match pwait2(queue.as_raw_fd(), &mut event, 1, &zero) {
+            Ok(_) => true,
+            Err(error) if error.raw_os_error() == Some(libc::ENOSYS) => false,
+            Err(error) => return Err(error),
+        };
+        let poller = Self {
+            queue,
+            interrupt,
+            precise_timeout,
+        };
+        poller.change(
+            libc::EPOLL_CTL_ADD,
+            poller.interrupt.as_raw_fd(),
+            INTERRUPT,
+            libc::EPOLLIN as u32,
+        )?;
+        Ok(poller)
+    }
+    pub(super) fn supports_edge(&self) -> bool {
+        true
+    }
+    pub(super) unsafe fn add_with_mode(
+        &self,
+        socket: &socket2::Socket,
+        event: Event,
+        mode: PollMode,
+    ) -> io::Result<()> {
+        debug_assert_eq!(mode, PollMode::Edge);
+        let mut flags = libc::EPOLLET as u32;
+        if event.readable {
+            flags |= READ;
+        }
+        if event.writable {
+            flags |= WRITE;
+        }
+        self.change(libc::EPOLL_CTL_ADD, socket.as_raw_fd(), event.key, flags)
+    }
+    pub(super) fn delete(&self, socket: &socket2::Socket) -> io::Result<()> {
+        self.change(libc::EPOLL_CTL_DEL, socket.as_raw_fd(), 0, 0)
+    }
+    fn change(&self, operation: i32, descriptor: i32, key: usize, flags: u32) -> io::Result<()> {
+        let mut event = libc::epoll_event {
+            events: flags,
+            u64: key as u64,
+        };
+        loop {
+            // SAFETY: Descriptor owners and event storage live through this synchronous call.
+            let result = unsafe {
+                libc::epoll_ctl(self.queue.as_raw_fd(), operation, descriptor, &mut event)
+            };
+            if result >= 0 {
+                return Ok(());
+            }
+            let error = io::Error::last_os_error();
+            if error.kind() != io::ErrorKind::Interrupted {
+                return Err(error);
+            }
+        }
+    }
+    pub(super) fn notify(&self) -> io::Result<()> {
+        let value = 1u64;
+        loop {
+            // SAFETY: eventfd synchronously borrows exactly eight initialized bytes.
+            let result = unsafe {
+                libc::write(self.interrupt.as_raw_fd(), (&value as *const u64).cast(), 8)
+            };
+            if result >= 0 {
+                return Ok(());
+            }
+            let error = io::Error::last_os_error();
+            match error.kind() {
+                io::ErrorKind::Interrupted => continue,
+                // A saturated eventfd is already readable and retains the wake.
+                io::ErrorKind::WouldBlock => return Ok(()),
+                _ => return Err(error),
+            }
+        }
+    }
+    pub(super) fn clear_notification(&self) {
+        let mut value = 0u64;
+        loop {
+            // SAFETY: The initialized result has room for eventfd's eight-byte counter.
+            let result = unsafe {
+                libc::read(
+                    self.interrupt.as_raw_fd(),
+                    (&mut value as *mut u64).cast(),
+                    8,
+                )
+            };
+            if result >= 0 || io::Error::last_os_error().kind() != io::ErrorKind::Interrupted {
+                return;
+            }
+        }
+    }
+    pub(super) fn wait(&self, events: &mut Events, timeout: Option<Duration>) -> io::Result<usize> {
+        events.raw.reserve(BATCH);
+        let length = events.raw.len();
+        // SAFETY: The vector has BATCH spare entries, exclusively borrowed until the call returns.
+        let output = unsafe { events.raw.as_mut_ptr().add(length) };
+        let count = if self.precise_timeout {
+            let timeout = timeout.map(|value| KernelTimespec {
+                tv_sec: value.as_secs().min(i64::MAX as u64) as i64,
+                tv_nsec: value.subsec_nanos() as i64,
+            });
+            pwait2(
+                self.queue.as_raw_fd(),
+                output,
+                BATCH as i32,
+                timeout.as_ref().map_or(ptr::null(), |value| value),
+            )?
+        } else {
+            // Round up so old kernels never expire a finite timeout early.
+            let millis = timeout.map_or(-1, |value| {
+                value.as_nanos().div_ceil(1_000_000).min(i32::MAX as u128) as i32
+            });
+            // SAFETY: output has BATCH spare entries, and the kernel borrows it only for this call.
+            let result =
+                unsafe { libc::epoll_wait(self.queue.as_raw_fd(), output, BATCH as i32, millis) };
+            if result < 0 {
+                return Err(io::Error::last_os_error());
+            }
+            result as usize
+        };
+        // SAFETY: Only the returned prefix was initialized by the synchronous wait.
+        unsafe { events.raw.set_len(length + count) };
+        Ok(count)
+    }
+}
+fn owned(descriptor: i32) -> io::Result<OwnedFd> {
+    if descriptor < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: The caller transfers sole ownership of a newly created descriptor.
+    Ok(unsafe { OwnedFd::from_raw_fd(descriptor) })
+}
+fn pwait2(
+    queue: i32,
+    events: *mut libc::epoll_event,
+    capacity: i32,
+    timeout: *const KernelTimespec,
+) -> io::Result<usize> {
+    // SAFETY: All callers provide capacity writable entries and a valid optional timespec. The signal mask is null; eight is the Linux kernel signal-set size, independent of libc's larger userspace sigset_t.
+    let result = unsafe {
+        libc::syscall(
+            libc::SYS_epoll_pwait2,
+            queue,
+            events,
+            capacity,
+            timeout,
+            ptr::null::<libc::sigset_t>(),
+            8usize,
+        )
+    };
+    if result < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(result as usize)
+}
+
+pub(super) struct Events {
+    raw: Vec<libc::epoll_event>,
+}
+impl Events {
+    pub(super) fn new() -> Self {
+        Self {
+            raw: Vec::with_capacity(BATCH),
+        }
+    }
+    pub(super) fn clear(&mut self) {
+        self.raw.clear();
+    }
+    // Interrupts are handled in the driver's sole dispatch pass, before pointer decoding.
+    pub(super) fn iter(&self) -> impl Iterator<Item = Event> + '_ {
+        self.raw.iter().map(|event| {
+            Event::new(
+                event.u64 as usize,
+                event.events & READ != 0,
+                event.events & WRITE != 0,
+            )
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests;
