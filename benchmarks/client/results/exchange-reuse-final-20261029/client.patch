+    fn storage_can_be_taken_and_returned_from_different_threads() {
+        let cache = Cache::new();
+        let capture = Arc::new(());
+        let drops = Arc::new(AtomicUsize::new(0));
+        std::thread::scope(|scope| {
+            for _ in 0..4 {
+                let cache = &cache;
+                let capture = &capture;
+                let drops = &drops;
+                scope.spawn(move || {
+                    for _ in 0..100 {
